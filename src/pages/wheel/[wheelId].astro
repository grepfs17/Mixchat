---
import ContentLayout from "../../layouts/ContentLayout.astro";
import WheelApp from "../../components/wheel/WheelApp";
import "../../styles/themes.css";
import "../../styles/wheel.css";

const { wheelId } = Astro.params;
const title = "Wheel Spin | Mixchat";
const description =
    "A shared prize wheel powered by Mixchat. Spin to pick a winner.";
---

<ContentLayout {title} {description}>
    <WheelApp client:only="react" initialWheelId={wheelId ?? null} />
</ContentLayout>
