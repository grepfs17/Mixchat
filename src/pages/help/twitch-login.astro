---
import ContentLayout from "../../layouts/ContentLayout.astro";
import LegalStyles from "../../components/legal/LegalStyles.astro";
import { IS_DESKTOP, IS_TWITCH_ONLY } from "../../lib/constants";

// The guide documents the desktop device-code flow only. Hosted builds send
// visitors back to the app.
if (!IS_DESKTOP) return Astro.redirect("/");

const mainUrl = Astro.site?.toString() ?? "https://mixchat.grepfs.xyz/";
const title = "How to log in with Twitch - Mixchat";
const description =
    "How to connect your Twitch account in the Mixchat desktop app so the chat and the embedded player both stay signed in.";
---

<ContentLayout {title} {description} ogUrl={`${mainUrl}help/twitch-login`}>
    <Fragment slot="head">
        <LegalStyles />
    </Fragment>
    <div style="text-align: center; margin-bottom: 30px;">
        <img
            src={IS_TWITCH_ONLY ? "/logo-twitch.webp" : "/logo.webp"}
            alt="Mixchat Logo"
            width="80"
            height="80"
            style="width: auto; height: 80px;"
        />
    </div>
    <h1>How to log in with Twitch</h1>
    <p class="meta">Mixchat desktop app</p>

    <p>
        When you click <strong>Log in with Twitch</strong>, Mixchat shows a code
        and opens Twitch's activation page. Follow the steps below so both the
        chat and the embedded player end up signed in.
    </p>

    <h2>1. Start the login</h2>
    <p>
        Click <strong>Log in with Twitch</strong>. The Connect Twitch dialog
        opens with your code, and the Twitch activation page opens next to it
        in a Mixchat window. If you closed that window, click
        <strong>Open twitch.tv/activate</strong> in the dialog to bring it back
        inside Mixchat.
    </p>

    <h2>2. Log in on the Twitch page</h2>
    <p>
        In the Mixchat window that opened, make sure you are signed in to the
        Twitch account you want to use. Choosing <strong>Log in</strong> keeps
        the sign-in inside that window, which is what the player needs.
    </p>
    <img
        src="/help/twitch-login/activate-login.png"
        alt="Twitch activation page open in the Mixchat Authorize Twitch window, with the Log in button marked"
        style="max-width: 460px; width: 100%; border: 1px solid #333; border-radius: 8px; margin-top: 10px;"
    />

    <h2>3. Enter the code and activate</h2>
    <p>
        Type the code from the dialog and click <strong>Activate</strong>. When
        Twitch confirms, the dialog and the Twitch window close by themselves
        and Mixchat is signed in.
    </p>
    <img
        src="/help/twitch-login/activate-confirm.png"
        alt="Twitch activation page with the device code filled in and the Activate button marked"
        style="max-width: 460px; width: 100%; border: 1px solid #333; border-radius: 8px; margin-top: 10px;"
    />

    <p
        style="background: #1a1a1a; border-left: 3px solid var(--color-twitch); padding: 12px 16px; border-radius: 4px;"
    >
        <strong>Important:</strong> finish the login in the window Mixchat
        opens. If you enter the code in a different browser, the chat connects
        but the embedded player stays signed out, because the player reads
        Twitch's cookies from the Mixchat window.
    </p>
</ContentLayout>
