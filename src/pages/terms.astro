---
import ContentLayout from "../layouts/ContentLayout.astro";
import LegalStyles from "../components/legal/LegalStyles.astro";
import TermsWeb from "../components/legal/TermsWeb.astro";
import TermsDesktop from "../components/legal/TermsDesktop.astro";
import { IS_DESKTOP, IS_TWITCH_ONLY } from "../lib/constants";

const mainUrl = Astro.site?.toString() ?? "https://mixchat.grepfs.xyz/";
const title = "Terms of Service - Mixchat";
const description = IS_TWITCH_ONLY
    ? "Mixchat Terms of Service: unofficial Twitch chat client provided as-is under the AGPL-3.0 License."
    : "Mixchat Terms of Service: unofficial Twitch and YouTube chat client provided as-is under the AGPL-3.0 License.";
---

<ContentLayout {title} {description} ogUrl={`${mainUrl}terms`}>
    <Fragment slot="head">
        <LegalStyles />
    </Fragment>
    <div style="text-align: center; margin-bottom: 30px;">
        <img
            src={IS_TWITCH_ONLY ? "/logo-twitch.webp" : "/logo.webp"}
            alt="Mixchat Logo"
            width="80"
            height="80"
            style="width: auto; height: 80px;"
        />
    </div>
    <h1>Terms of Service</h1>
    <p class="meta">Last updated: November 9, 2026</p>

    {IS_DESKTOP ? <TermsDesktop /> : <TermsWeb />}

    <h2>6. Contact</h2>
    <p>
        Questions? Reach out on
        <a href="https://forgejo.grepfs.xyz/grepfs17/Mixchat" target="_blank">
            Forgejo
        </a>
        .
    </p>

    <hr style="margin-top: 50px; border: none; border-top: 1px solid #333;" />
    <p style="text-align: center; color: #666; font-size: 12px; margin-top: 20px;">
        <a href="/">Back to Mixchat</a>
    </p>
</ContentLayout>
