---
import MainLayout from "../../layouts/MainLayout.astro";

const { name } = Astro.params;

const title = `Mixchat — ${name}`;
const description =
  "Advanced Twitch and YouTube chat client with support for 7TV, BTTV, and FFZ emotes without browser extensions.";

const mainUrl = Astro.site?.toString() ?? "https://mixchat.grepfs.xyz/";
---

<MainLayout title={title} description={description} ogUrl={`${mainUrl}channel/${name}`} footerLogo />
