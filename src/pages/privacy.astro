---
import ContentLayout from "../layouts/ContentLayout.astro";
import LegalStyles from "../components/legal/LegalStyles.astro";
import PrivacyWeb from "../components/legal/PrivacyWeb.astro";
import PrivacyDesktop from "../components/legal/PrivacyDesktop.astro";
import { IS_DESKTOP, IS_TWITCH_ONLY } from "../lib/constants";

const mainUrl = Astro.site?.toString() ?? "https://mixchat.grepfs.xyz/";
const title = "Privacy Policy - Mixchat";
const description =
    "Mixchat Privacy Policy: no Mixchat chat database, recent chat history cached on your device for up to 5 days, OAuth tokens in secure httpOnly cookies.";
---

<ContentLayout {title} {description} ogUrl={`${mainUrl}privacy`}>
    <Fragment slot="head">
        <LegalStyles />
    </Fragment>
    <div style="text-align: center; margin-bottom: 30px;">
        <img
            src={IS_TWITCH_ONLY ? "/logo-twitch.webp" : "/logo.webp"}
            alt="Mixchat Logo"
            width="80"
            height="80"
            style="width: auto; height: 80px;"
        />
    </div>
    <h1>Privacy Policy</h1>
    <p class="meta">Last updated: November 9, 2026</p>

    {IS_DESKTOP ? <PrivacyDesktop /> : <PrivacyWeb />}

    <h2>7. Changes</h2>
    <p>
        Mixchat changes fast. The date at the top will be updated if there are
        ever changes to how info is handled (like adding a new feature that
        needs a different API).
    </p>

    <h2>8. Contact</h2>
    <p>
        If you have questions about any of this, open an issue on the
        <a href="https://forgejo.grepfs.xyz/grepfs17/Mixchat" target="_blank">
            {" "}
            Forgejo repository
        </a>
        .
    </p>

    <hr style="margin-top: 50px; border: none; border-top: 1px solid #333;" />
    <p style="text-align: center; color: #666; font-size: 12px; margin-top: 20px;">
        <a href="/">Back to Mixchat</a>
    </p>
</ContentLayout>
