# Mixchat Environment Variables

# ── Server ──
NODE_ENV=production
ORIGIN=https://yoururl.site

# ── Twitch (https://dev.twitch.tv/console/apps) ──
TWITCH_GQL_CLIENT_ID=
PUBLIC_TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
PUBLIC_TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback

# ── YouTube OAuth (https://console.cloud.google.com/) ──
PUBLIC_YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
PUBLIC_YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback

# ── YouTube InnerTube (optional) ──
YT_DEBUG=0
# YT_MAX_SESSIONS=200       # Max concurrent YouTube live chat sessions (default: 200)
# YT_USER_AGENT=
# YT_POTOKEN=            # Set to "off" to disable auto-generation
# YT_VISITOR_DATA=       # If set, overrides auto-generated visitor data
# YT_COOKIE=             # Browser cookie string for authenticated InnerTube access
# YT_CLIENT=WEB          # WEB, TV, TVHTML5_SIMPLY_EMBEDDED_PLAYER
# YT_GENERATE_SESSION_LOCALLY=true
# YT_CHAT_COOLDOWN_MS=600000

# ── YouTube Vercel Proxy (optional — routes InnerTube via Vercel to avoid 403s) ──
# YT_PROXY=https://proxy1.vercel.app,https://proxy2.vercel.app  # Comma-separated list; failover to next on failure
# YT_PROXY_TOKEN=                         # Shared secret (must match proxy's AUTH_TOKEN)