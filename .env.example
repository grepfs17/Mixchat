# Environment Configuration for Mixchat

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Public-facing origin URL (required in production behind a reverse proxy).
# Astro's Node standalone adapter uses this to correctly resolve SSR routes.
# Without it, direct navigation to dynamic routes (e.g. /channel/name) may 404.
ORIGIN=https://yoururl.site

# ── Twitch ───────────────────────────────────────────────────────────────────
# Get from: https://dev.twitch.tv/console/apps
TWITCH_GQL_CLIENT_ID=This key can be the Twitch public one, easy obtainable
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback

# ── YouTube OAuth (per-user, for sending chat messages) ───────────────────────
# Get from: https://console.cloud.google.com/
YT_API_KEY=your_YT_API_KEY_here
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback

# ── YouTube server auth (for reading live chat) ───────────────────────────────
# Protects the one-time device-code setup endpoint /api/youtube-device-auth.
# Generate with: openssl rand -hex 32
YT_ADMIN_SECRET=change-me-to-a-strong-random-secret

# Optional: where to store the server OAuth credentials file.
# Defaults to <cwd>/yt-credentials.json (already in .gitignore).
# YT_CREDENTIALS_PATH=/home/user/secrets/yt-credentials.json

# ── YouTube InnerTube tuning (optional) ──────────────────────────────────────
# Set to 1 to prefer YouTube Data API over InnerTube for public lookups.
YT_PREFER_DATA_API=0
# Optional: Custom User-Agent for InnerTube requests.
# YT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/117.0.0.0 Safari/537.36
# Legacy cookie fallback (only used if no yt-credentials.json exists):
# YT_COOKIE=SID=...; HSID=...; SSID=...; SAPISID=...; __Secure-3PAPISID=...; __Secure-3PSID=...
