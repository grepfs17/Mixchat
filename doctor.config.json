{
  "$schema": "https://react.doctor/schema/config.json",
  "//": "Each suppressed rule has individual audit-trail entries in .react-doctor/false-positives.md explaining why the pattern is safe in this codebase. WIP: no-giant-component (extract sub-components) and prefer-html-dialog (convert to native <dialog>) are planned for future refactoring.",
  "rules": {
    "react-doctor/no-adjust-state-on-prop-change": "off",
    "react-doctor/dangerous-html-sink": "off",
    "react-doctor/effect-needs-cleanup": "off",
    "react-doctor/no-array-index-as-key": "off",
    "react-doctor/no-effect-chain": "off",
    "react-doctor/prefer-use-sync-external-store": "off",
    "react-doctor/no-fetch-in-effect": "off",
    "react-doctor/no-pass-live-state-to-parent": "off",
    "react-doctor/no-prop-callback-in-effect": "off",
    "react-doctor/no-pass-data-to-parent": "off",
    "react-doctor/no-derived-state": "off",
    "react-doctor/media-has-caption": "off",
    "react-doctor/prefer-html-dialog": "off",
    "react-doctor/no-flush-sync": "off",
    "react-doctor/client-localstorage-no-version": "off",
    "react-doctor/no-promise-then-side-effect-in-effect-without-catch": "off",
    "react-doctor/no-set-state-after-await-in-effect": "off",
    "react-doctor/no-loading-flag-reset-outside-finally": "off",
    "react-doctor/no-ref-current-in-render": "off",
    "react-doctor/no-giant-component": "off",
  "react-doctor/no-many-boolean-props": "off",
    "react-doctor/no-multi-comp": "off"
}
}
